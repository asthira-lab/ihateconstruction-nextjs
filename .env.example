# =====================================================================
# Copy this file to `.env.local` for local development, and set matching
# vars in Vercel's Project Settings → Environment Variables for production.
# =====================================================================

# =====================================================================
# CLIENT-VISIBLE — inlined into the browser bundle at build time.
# Never put secrets here.
# =====================================================================

# Canonical site URL. Used for absolute URLs in metadata (canonical,
# openGraph.url), sitemap.xml, and metadataBase.
#
# Local dev  : http://localhost:3000  (Next.js default frontend port)
# Vercel prod: https://ihateconstruction.co
# Vercel prev: leave blank — Vercel auto-injects the preview URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =====================================================================
# SERVER-ONLY — never sent to the browser. Do NOT prefix with NEXT_PUBLIC_.
# =====================================================================

# --- Database (OPTIONAL) ---------------------------------------------
# Phase 1 calculators are pure server-side functions and don't need a
# database. Leave DATABASE_URL unset and the app runs stateless.
#
# When we start persisting saved calculations, quotations, and project
# history (Phase 2+), point this at any managed Postgres:
#
#   Aiven format:
#     postgres://<user>:<password>@<host>:<port>/<db>?sslmode=require
#
# Mark "Sensitive" in Vercel. Never commit real credentials — copy this
# file to `.env.local` (gitignored) and paste them there.
# DATABASE_URL=

# SSL mode for the pool. Managed Postgres providers require "require".
# Set "disable" only for a local dev Postgres without SSL. Default: require.
# DATABASE_SSL=require

# Per-connection timeout in milliseconds. Default 8000, max 60000.
# DATABASE_TIMEOUT_MS=8000
